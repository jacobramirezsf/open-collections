{
  "name": "open-collections",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p api/tsconfig.json",
    "ingest": "node scripts/ingest/run.mjs",
    "index:build": "node scripts/ingest/build-index.mjs",
    "index:upload": "node scripts/upload-index.mjs",
    "api:dev": "vercel dev"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@vercel/blob": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "1.55",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}