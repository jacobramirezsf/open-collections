{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/((?!api/|assets/|paper/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" }] }
  ]
}
